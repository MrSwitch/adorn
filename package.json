{
  "name": "adorn-kit",
  "version": "1.3.3",
  "description": "Markup beautifier drop in script",
  "type": "module",
  "main": "adorn.js",
  "private": true,
  "scripts": {
    "build": "node ./build.js",
    "watch": "node --watch-path ./src ./build.js",
    "serve": "bundle exec jekyll serve",
    "lint": "eslint ./",
    "lint-fix": "eslint --fix ./",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "test": "npm run lint && npm run typecheck && npm run build",
    "lint-diff": "LIST=`git diff-index --name-only HEAD | grep '.*\\.ts$';`; if [ \"$LIST\" ]; then eslint $LIST; fi",
    "precommit-msg": "echo 'Running pre-commit checks... (skip using --no-verify)' && exit 0"
  },
  "pre-commit": [
    "precommit-msg",
    "lint-diff"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MrSwitch/adorn.git"
  },
  "author": "Andrew Dodson",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MrSwitch/adorn/issues"
  },
  "homepage": "https://github.com/MrSwitch/adorn",
  "devDependencies": {
    "esbuild": "^0.25.5",
    "esbuild-plugin-less": "^1.3.23",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "less": "^4.3.0",
    "pre-commit": "^1.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "tricks": "^2.5.0-rc.2"
  }
}
